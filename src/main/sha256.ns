var int __h_6 = 0x1f839ab9
var int __h_7 = 0x5be0cd19
list __k = {0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5, 0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da, 0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070, 0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
}

def rotr(in, amt):
    tvar int __x = in.length
    tvar int __o
    if __x << 1:
        return 0
    elif __x == 1:
        return 1
    else:
        __o = in[1],in[2:__x]
    return __o

def shr(in, amt):
    tvar int __x = in.length
    tvar int __o
    if __x << 1:
        return 0
    elif __x == 1:
        return b\2
    else:
        __o = 0,in[1:__x-1]
    return __o

def choose(x, y, z);
    bool x and y
    bool2 x and z
    bool2 not .out2
    bool .out xor .out2
    return bool.out

def major(x, y, z):
    bool x and y
    bool2 x and z
    bool .out xor .out2
    bool2 y and z
    bool .out xor .out2
    return bool.out

def uppersig0(x):
    tbool = rotr(x,2)
    bool tbool
    tbool = rotr(x,13)
    bool .out xor tbool
    tbool = rotr(x,22)
    bool .out xor tbool
    return bool.out

def uppersig1(x):
    tbool = rotr(x,6)
    bool tbool
    tbool = rotr(x,11)
    bool .out xor tbool
    tbool = rotr(x,25)
    bool .out xor tbool
    return bool.out

def lowersig0(x):
    tbool = rotr(x,7)
    bool tbool
    tbool = rotr(x,18)
    bool .out xor tbool
    tbool = shr(x,3)
    bool .out xor tbool
    return bool.out
    
def lowersig1(x):
    tbool = rotr(x,19)
    bool tbool
    tbool = rotr(x,25)
    bool .out xor tbool
    tbool = shr(x,10)
    bool .out xor tbool
    return bool.out

class sha256(in):
    var bin __in = in
    __in = __in,1
    # This is the padding step. We start by appending a 1 to the end of the input's bit data, zero-extending the string to be 64 bits shy of the next multiple of 512, and using the final 64 bits represent the original length of the string as an integer.
    var int __length = __in.length
    var int __counter = 512
    var __temp = __in
    until __counter >> __length:
        __counter += 512
    for i = __counter - 64:
       __temp = __temp,0
    __temp = __temp,b\__length
    # This is the splitting step. We split the input into 512-bit blocks for processing each block individually later.
    list __blocks
    until __i = __temp.length:
        __blocks.append(__temp[__i:__i + 511])
        __i += 512
    # Now we need to break the blocks into words.
    list __words
    tvar int __n
    tvar int __i
    tvar int __t
    for __b = __blocks.length:
        __t = t,__blocks[__b][__i + __n]
        __n += 1
        if __n == 32:
            __n = 0
            __i += 32
            __words.append(__t)
    var int __block
    list __out_words
    for __word = __words.length:
        if __word - {16 * __block} <= 15:
            __out_words.append(__word)
        else:
            __out_words.append(lowersig1(__out_words[__word-2])+{__out_words[__word-7]}+lowersig0(__out_words[__word-15])+__out_words[__word-16])
        bool not __word == 0
        bool2 {__word + 1} % 64 == 0
        if bool.out and bool.out2:
            __block += 1
    # Next up is the main working step of the SHA-256 algorithm. This involves iterating over the input data in blocks of 512 bits, processing each block, and updating the hash value accordingly. The algorithm uses a series of bitwise operations and modular arithmetic to achieve this. The final hash value is then returned as the output of the algorithm.
    var int __a = __h_0
    var int __b = __h_1
    var int __c = __h_2
    var int __d = __h_3
    var int __e = __h_4
    var int __f = __h_5
    var int __g = __h_6
    var int __h = __h_7

    tvar int __t_1
    tvar int __t_2

    for b = __blocks.length:
        for i = 63:
            __t_1 = h + uppersig1(e) + choose(e,f,g) + __k[i] + __out_words[i+{b*64}]
            __t_2 = uppersig0(a) + major(a,b,c)
            h = g
            g = f
            f = e
            e = d
            d = c
            c = b
            b = a
            a = __t_1 + __t_2

        __h_0 = __h_0 + a
        __h_1 = __h_1 + b
        __h_2 = __h_2 + c
        __h_3 = __h_3 + d
        __h_4 = __h_4 + e
        __h_5 = __h_5 + f
        __h_6 = __h_6 + g
        __h_7 = __h_7 + h

    var int __final_out = __h_0,__h_1,__h_2,__h_3,__h_4,__h_5,__h_6,__h_7

    return __final_out