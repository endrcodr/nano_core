# This is the SHA-256 hasher for the core Nano language.
# It is used primarily for ensuring the security of injected packages.
# It is written in Nano for readability.
# It is required for the Nano compiler to compile any other programs.
#
# call(sha256, data) gives back the 256-bit digest of the bits of `data` (a bin of 1 to 32703 bits) as a bin.
# The bits are hashed as they are written: 0x616263 is the three bytes "abc".
# (A bin always has at least one bit, so the empty message can not be given to it.)

class sha256(in):
    var bin __in = in
    var int __length = __in.length
    # This is the padding step. We start by appending a 1 to the end of the input's bit data, zero-extending the string to be 64 bits shy of the next multiple of 512, and using the final 64 bits represent the original length of the string as an integer.
    __in = __in,1
    var int __need = __length + 65
    var int __counter = 512
    until __counter >= __need:
        __counter += 512
    var int __zeros = __counter - 65 - __length
    var int __z = 0
    for __z = __zeros:
        __in = __in,0
    __in = __in,b\__length
    # The constants: the first 32 bits of the fractional parts of the cube roots of the first 64 primes ...
    var bin __k = 0x428a2f9871374491b5c0fbcfe9b5dba53956c25b59f111f1923f82a4ab1c5ed5
    __k = __k,0xd807aa9812835b01243185be550c7dc372be5d7480deb1fe9bdc06a7c19bf174
    __k = __k,0xe49b69c1efbe47860fc19dc6240ca1cc2de92c6f4a7484aa5cb0a9dc76f988da
    __k = __k,0x983e5152a831c66db00327c8bf597fc7c6e00bf3d5a7914706ca635114292967
    __k = __k,0x27b70a852e1b21384d2c6dfc53380d13650a7354766a0abb81c2c92e92722c85
    __k = __k,0xa2bfe8a1a81a664bc24b8b70c76c51a3d192e819d6990624f40e3585106aa070
    __k = __k,0x19a4c1161e376c082748774c34b0bcb5391c0cb34ed8aa4a5b9cca4f682e6ff3
    __k = __k,0x748f82ee78a5636f84c878148cc7020890befffaa4506cebbef9a3f7c67178f2
    # ... and the starting hash: the same for the square roots of the first 8 primes.
    var bin __hs = 0x6a09e667bb67ae853c6ef372a54ff53a
    __hs = __hs,0x510e527f9b05688c1f83d9ab5be0cd19
    # Now we go through the blocks of 512 bits, one at a time.
    var int __off = 0
    until __off >= __counter:
        # The message schedule: the 16 words of the block, then 48 more made from the ones before them. __w holds
        # all 64 words one after the other (word t is the bits t * 32 to t * 32 + 31).
        var bin __w = __in[__off : __off + 511]
        var int __t = 16
        until __t == 64:
            var int __p = __t * 32
            var bin __x = __w[__p - 480 : __p - 449]
            var bin __s0 = __x >>> 7 xor __x >>> 18 xor __x >> 3
            __x = __w[__p - 64 : __p - 33]
            var bin __s1 = __x >>> 17 xor __x >>> 19 xor __x >> 10
            var bin __nw = __s1 add __w[__p - 224 : __p - 193] add __s0 add __w[__p - 512 : __p - 481]
            __w = __w,__nw
            __t += 1
        # The working variables start as the current hash.
        var bin __a = __hs[0 : 31]
        var bin __b = __hs[32 : 63]
        var bin __c = __hs[64 : 95]
        var bin __d = __hs[96 : 127]
        var bin __e = __hs[128 : 159]
        var bin __f = __hs[160 : 191]
        var bin __g = __hs[192 : 223]
        var bin __h = __hs[224 : 255]
        # The 64 rounds.
        __t = 0
        until __t == 64:
            var int __q = __t * 32
            var bin __e1 = __e >>> 6 xor __e >>> 11 xor __e >>> 25
            var bin __ch1 = __e and __f
            var bin __ch2 = not __e and __g
            var bin __ch = __ch1 xor __ch2
            var bin __t1 = __h add __e1 add __ch add __k[__q : __q + 31] add __w[__q : __q + 31]
            var bin __a1 = __a >>> 2 xor __a >>> 13 xor __a >>> 22
            var bin __mj1 = __a and __b
            var bin __mj2 = __a and __c
            var bin __mj3 = __b and __c
            var bin __mj = __mj1 xor __mj2 xor __mj3
            var bin __t2 = __a1 add __mj
            __h = __g
            __g = __f
            __f = __e
            __e = __d add __t1
            __d = __c
            __c = __b
            __b = __a
            __a = __t1 add __t2
            __t += 1
        # The block's result is added to the hash (every addition wraps at 32 bits).
        var bin __n0 = __hs[0 : 31] add __a
        var bin __n1 = __hs[32 : 63] add __b
        var bin __n2 = __hs[64 : 95] add __c
        var bin __n3 = __hs[96 : 127] add __d
        var bin __n4 = __hs[128 : 159] add __e
        var bin __n5 = __hs[160 : 191] add __f
        var bin __n6 = __hs[192 : 223] add __g
        var bin __n7 = __hs[224 : 255] add __h
        __hs = __n0,__n1,__n2,__n3,__n4,__n5,__n6,__n7
        __off += 512
    ret __hs
