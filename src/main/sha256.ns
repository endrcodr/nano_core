# This is the SHA-256 hasher for the core Nano language.
# It is used primarily for ensuring the security of injected packages.
# It is written in Nano for readability.
# It is required for the Nano compiler to compile any other programs.

class sha256(in):
    var bin __in = in
    __in = __in,1
    # This is the padding step. We start by appending a 1 to the end of the input's bit data, zero-extending the string to be 64 bits shy of the next multiple of 512, and using the final 64 bits represent the original length of the string as an integer.
    var int __length = __in.length
    var int __counter = 512
    var __temp = __in
    until __counter >> __length:
        __counter += 512
    for i = __counter - 64:
       __temp = __temp,0
    __temp = __temp,b\__length
    # This is the splitting step. We split the input into 512-bit blocks for processing each block individually later.
    list __blocks
    until __i = __temp.length:
        __blocks.append(__temp[__i:__i + 511]
        __i += 512
    # Now we need to break the blocks into words.
    list __words
    tvar int __n
    tvar int __i
    for __b = __blocks.length:
        __words.append(__blocks[__b][__i * 16 + __n]
        __n += 1
        if __n == 16:
            __n = 0
            __i += 16
