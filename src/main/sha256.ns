# This is the SHA-256 hasher for the core Nano language.
# It is used primarily for ensuring the security of injected packages.
# It is written in Nano for readability.
# It is required for the Nano compiler to compile any other programs.

var int __tint
var bool __tbool
var int __h_0 = 0x

def rotr(in, amt):
    tvar int __x = in.length
    tvar int __o
    if __x << 1:
        return 0
    elif __x == 1:
        return 1
    else:
        __o = in[1],in[2:__x]
    return __o

def shr(in, amt):
    tvar int __x = in.length
    tvar int __o
    if __x << 1:
        return 0
    elif __x == 1:
        return b\2
    else:
        __o = 0,in[1:__x-1]
    return __o

def choose(x, y, z);
    bool x and y
    bool2 x and z
    bool2 not .out2
    bool .out xor .out2
    return bool.out

def major(x, y, z):
    bool x and y
    bool2 x and z
    bool .out xor .out2
    bool2 y and z
    bool .out xor .out2
    return bool.out

def uppersig0(x):
    tbool = rotr(x,2)
    bool tbool
    tbool = rotr(x,13)
    bool .out xor tbool
    tbool = rotr(x,22)
    bool .out xor tbool
    return bool.out

def uppersig1(x):
    tbool = rotr(x,6)
    bool tbool
    tbool = rotr(x,11)
    bool .out xor tbool
    tbool = rotr(x,25)
    bool .out xor tbool
    return bool.out

def lowersig0(x):
    tbool = rotr(x,7)
    bool tbool
    tbool = rotr(x,18)
    bool .out xor tbool
    tbool = shr(x,3)
    bool .out xor tbool
    return bool.out
    
def lowersig1(x):
    tbool = rotr(x,19)
    bool tbool
    tbool = rotr(x,25)
    bool .out xor tbool
    tbool = shr(x,10)
    bool .out xor tbool
    return bool.out

class sha256(in):
    var bin __in = in
    __in = __in,1
    # This is the padding step. We start by appending a 1 to the end of the input's bit data, zero-extending the string to be 64 bits shy of the next multiple of 512, and using the final 64 bits represent the original length of the string as an integer.
    var int __length = __in.length
    var int __counter = 512
    var __temp = __in
    until __counter >> __length:
        __counter += 512
    for i = __counter - 64:
       __temp = __temp,0
    __temp = __temp,b\__length
    # This is the splitting step. We split the input into 512-bit blocks for processing each block individually later.
    list __blocks
    until __i = __temp.length:
        __blocks.append(__temp[__i:__i + 511]
        __i += 512
    # Now we need to break the blocks into words.
    list __words
    tvar int __n
    tvar int __i
    tvar int __t
    for __b = __blocks.length:
        __t = t,__blocks[__b][__i + __n]
        __n += 1
        if __n == 32:
            __n = 0
            __i += 32
            __words.append(__t)
    var int __block
    list __out_words
    for __word = __words.length:
        if __word - {16 * __block} <= 15:
            __out_words.append(__word)
        else:
            __out_words.append(lowersig1(__out_words[__word-2])+{__out_words[__word-7]}+lowersig0(__out_words[__word-15])+__out_words[__word-16])
        bool not __word == 0
        bool2 {__word + 1} % 64 == 0
        if bool.out and bool.out2:
            __block += 1













