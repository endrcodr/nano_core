STR s_dec_fa,    `    dec  qword [fa_`
STR s_fa_end0,   `], 0\n`
STR s_fa_end,    `]\n`
STR s_call_fn,   `    call fn_`
STR s_lea_rsi_fr, `    lea  rsi, [fr_`
STR s_b_rbr,     `_b]\n`
STR s_d_rbr,     `_d]\n`
