STR s_add_rax_rbx, `    add  rax, rbx\n`
STR s_add_m,     `    add  [`
STR s_sub_m,     `    sub  [`
STR s_call_sb_clear, `    call rt_sb_clear\n`
STR s_call_sb_space, `    call rt_sb_space\n`
STR s_call_sb_str,   `    call rt_sb_str\n`
STR s_call_sb_lstr,  `    call rt_sb_lstr\n`
STR s_call_sb_num,   `    call rt_sb_num\n`
STR s_call_str_to_sb, `    call rt_str_to_sb\n`
STR s_call_lstr_set, `    call rt_lstr_set\n`
STR s_call_lstr_app, `    call rt_lstr_append\n`
STR s_call_to_str,   `    call rt_to_str\n`
STR s_times,     `    times `
STR s_db0,       ` db 0\n`
STR s_lit_pre,   `lit_`

STR s_rt_frames, `\nsection .bss\nrt_svbuf:  resb SV_CAP\nrt_svp:    resq 1\nsection .text\nrt_err_deep:\n    mov  ecx, 0x205             ; calls nested too deeply (save area full)\n    jmp  rt_die\n\nrt_frame_save:                  ; rsi = start, ecx = length: copy to the save area (then [length][start])\n    mov  r8, [rt_svp]\n    mov  ecx, ecx\n    lea  r9, [r8 + rcx + 16]\n    cmp  r9, SV_CAP\n    ja   rt_err_deep\n    lea  rdx, [rt_svbuf]\n    lea  rdi, [rdx + r8]\n    mov  r10, rcx\n    mov  r11, rsi\n    rep movsb\n    mov  [rdi], r10\n    mov  [rdi + 8], r11\n    mov  [rt_svp], r9\n    ret\n\nrt_frame_restore:               ; undoes the last rt_frame_save (RAX is kept)\n    mov  r8, [rt_svp]\n    lea  rdx, [rt_svbuf]\n    lea  r9, [rdx + r8]\n    mov  rcx, [r9 - 16]\n    mov  rdi, [r9 - 8]\n    sub  r8, rcx\n    sub  r8, 16\n    mov  [rt_svp], r8\n    lea  rsi, [rdx + r8]\n    rep movsb\n    ret\n`
STR s_rt_sbsave, `\nrt_sb_save:                     ; the text builder goes to the save area\n    lea  rsi, [rt_sb]\n    mov  rcx, [rt_sb]\n    add  rcx, 8\n    jmp  rt_frame_save\nrt_sb_restore:\n    jmp  rt_frame_restore\n`
