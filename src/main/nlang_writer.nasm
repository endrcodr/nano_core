; nlang_writer.nasm - back end of the Nano compiler: emits NASM source text.
; Included at the bottom of nlang_compiler.nasm (shares its constants, ERR_* codes
; and the `vd_*` declaration block), after nlang_opener.nasm (needs path_buf/PATH_MAX).
;
; Output goes into a 1 MiB in-memory buffer and is written to <input>.nasm
; (script.n -> script.nasm) by out_end. The generated file is a complete win64
; program:   nasm -f win64 script.nasm
;
; Register rules: every emit_* routine uses only RAX, RCX, RDX, R8-R11, so the
; compiler's RSI/R12-R15 survive; write_var also uses RDI/RBX, which compile
; treats as scratch. Only out_flush calls the Windows API.
bits 64
default rel

extern CreateFileA
extern WriteFile
extern CloseHandle

OUT_SIZE equ 0x100000

; Which runtime helpers the program needs (bits of rt_need); emitted after main.
RT_STR_LEN     equ 0x001
RT_STR_IDX     equ 0x002
RT_LSTR_IDX    equ 0x004
RT_LIST_APPEND equ 0x008
RT_LIST_INSERT equ 0x010
RT_LIST_REMOVE equ 0x020
RT_LIST_GET    equ 0x040
RT_SORT_NUM    equ 0x080
RT_SORT_STR    equ 0x100
RT_TEXT        equ 0x200      ; text builder + join / copy / append helpers
RT_TEXT_NUM    equ 0x400      ; ... and number -> digits

section .bss
    out_buf    resb OUT_SIZE
    out_len    resq 1
    out_handle resq 1
    out_written resq 1
    out_path   resb PATH_MAX + 8        ; ".n"/".nc"/".ns" -> ".nasm" can be 2 longer
    num_buf    resb 32
    rt_need    resd 1
    resd 1
    lbl_ptr    resq 1
    lbl_len    resq 1

section .data
; (STR is defined in nlang_compiler.nasm, which includes this file)

STR s_header, `; Generated by the Nano compiler. Assemble with:  nasm -f win64 <this file>\nbits 64\ndefault rel\n\nextern ExitProcess\nglobal main\n\nLIST_CAP equ 1024               ; entries per list\nLSTR_CAP equ 4096               ; bytes of text per lstr\n\nsection .text\nmain:\n    sub  rsp, 40\n\n`
STR s_footer, `\n    xor  ecx, ecx\n    call ExitProcess\n`
STR s_sec_bss,  `section .bss\n`
STR s_sec_data, `section .data\n`
STR s_sec_text, `section .text\n`
STR s_vpre,     `v_`
STR s_resq,     `:  resq 1\n`
STR s_dq,       `:  dq `
STR s_db,       `    db `
STR s_comma,    `,`
STR s_nl,       `\n`
STR s_mov_rax,  `    mov  rax, `
STR s_store_a,  `\n    mov  [`
STR s_store_b,  `], rax\n`
STR s_todo,     `    ; TODO: statement type `
STR s_reslist,  `:  resq LIST_CAP + 1\n`          ; [count][LIST_CAP entries]
STR s_lbr,      `[`
STR s_rbr_nl,   `]\n`
STR s_lea_rcx,  `    lea  rcx, [`
STR s_mov_rax_b, `    mov  rax, [`
STR s_mov_rdx,  `    mov  rdx, `
STR s_mov_r8,   `    mov  r8, `
STR s_store_c,  `    mov  [`
STR s_clear_a,  `    mov  qword [`
STR s_clear_b,  `], 0\n`
STR s_call_str_len,   `    call rt_str_len\n`
STR s_call_str_idx,   `    call rt_str_idx\n`
STR s_call_lstr_idx,  `    call rt_lstr_idx\n`
STR s_call_append,    `    call rt_list_append\n`
STR s_call_insert,    `    call rt_list_insert\n`
STR s_call_remove,    `    call rt_list_remove\n`
STR s_call_get,       `    call rt_list_get\n`
STR s_call_sort_num,  `    call rt_list_sort_num\n`
STR s_call_sort_str,  `    call rt_list_sort_str\n`

; ---- runtime helpers, copied into the output when used ---------------------------
; Run-time failures exit with 0x201 (list full) or 0x202 (index out of range).
STR s_rt_common, `\n; ---- runtime helpers (only those this program uses) ----\nrt_err_full:\n    mov  ecx, 0x201             ; list is full\n    jmp  rt_die\nrt_err_range:\n    mov  ecx, 0x202             ; index out of range\nrt_die:\n    and  rsp, -16\n    sub  rsp, 32\n    call ExitProcess\n`
STR s_rt_str_len, `\nrt_str_len:                     ; rax = str -> rax = its length\n    xor  ecx, ecx\n.l: test rax, rax\n    jz   .d\n    shr  rax, 8\n    inc  ecx\n    jmp  .l\n.d: mov  eax, ecx\n    ret\n`
STR s_rt_str_idx, `\nrt_str_idx:                     ; rax = str, rdx = index -> rax = that character\n    cmp  rdx, 8\n    jae  rt_err_range\n    mov  ecx, edx\n    shl  ecx, 3\n    shr  rax, cl\n    movzx eax, al\n    test eax, eax               ; 0 = past the end of the string\n    jz   rt_err_range\n    ret\n`
STR s_rt_lstr_idx, `\nrt_lstr_idx:                    ; rcx = &lstr [len][bytes], rdx = index -> rax\n    cmp  rdx, [rcx]\n    jae  rt_err_range\n    movzx eax, byte [rcx + rdx + 8]\n    ret\n`
STR s_rt_append, `\nrt_list_append:                 ; rcx = list [count][entries], r8 = value\n    mov  rax, [rcx]\n    cmp  rax, LIST_CAP\n    jae  rt_err_full\n    mov  [rcx + rax*8 + 8], r8\n    inc  rax\n    mov  [rcx], rax\n    ret\n`
STR s_rt_insert, `\nrt_list_insert:                 ; rcx = list, rdx = index (0..count), r8 = value\n    mov  rax, [rcx]\n    cmp  rax, LIST_CAP\n    jae  rt_err_full\n    cmp  rdx, rax\n    ja   rt_err_range\n    mov  r9, rax\n.l: cmp  r9, rdx                ; shift the tail up by one\n    jbe  .p\n    mov  r10, [rcx + r9*8]\n    mov  [rcx + r9*8 + 8], r10\n    dec  r9\n    jmp  .l\n.p: mov  [rcx + rdx*8 + 8], r8\n    inc  rax\n    mov  [rcx], rax\n    ret\n`
STR s_rt_remove, `\nrt_list_remove:                 ; rcx = list, rdx = index\n    mov  rax, [rcx]\n    cmp  rdx, rax\n    jae  rt_err_range\n    dec  rax\n    mov  r9, rdx\n.l: cmp  r9, rax                ; shift the tail down by one\n    jae  .d\n    mov  r10, [rcx + r9*8 + 16]\n    mov  [rcx + r9*8 + 8], r10\n    inc  r9\n    jmp  .l\n.d: mov  [rcx], rax\n    ret\n`
STR s_rt_get, `\nrt_list_get:                    ; rcx = list, rdx = index -> rax\n    cmp  rdx, [rcx]\n    jae  rt_err_range\n    mov  rax, [rcx + rdx*8 + 8]\n    ret\n`
STR s_rt_sort_num, `\nrt_list_sort_num:               ; rcx = list; insertion sort, ascending, signed\n    lea  r8, [rcx + 8]\n    mov  r9d, 1\n.o: cmp  r9, [rcx]\n    jae  .d\n    mov  r10, [r8 + r9*8]\n    mov  r11, r9\n.i: test r11, r11\n    jz   .p\n    mov  rax, [r8 + r11*8 - 8]\n    cmp  rax, r10\n    jle  .p\n    mov  [r8 + r11*8], rax\n    dec  r11\n    jmp  .i\n.p: mov  [r8 + r11*8], r10\n    inc  r9\n    jmp  .o\n.d: ret\n`
STR s_rt_sort_str, `\nrt_list_sort_str:               ; rcx = list; strings in alphabetical order\n    lea  r8, [rcx + 8]          ; (bswap puts the first character in the top byte)\n    mov  r9d, 1\n.o: cmp  r9, [rcx]\n    jae  .d\n    mov  r10, [r8 + r9*8]\n    mov  rdx, r10\n    bswap rdx\n    mov  r11, r9\n.i: test r11, r11\n    jz   .p\n    mov  rax, [r8 + r11*8 - 8]\n    bswap rax\n    cmp  rax, rdx\n    jbe  .p\n    mov  rax, [r8 + r11*8 - 8]\n    mov  [r8 + r11*8], rax\n    dec  r11\n    jmp  .i\n.p: mov  [r8 + r11*8], r10\n    inc  r9\n    jmp  .o\n.d: ret\n`

STR s_cmp_rr,   `    cmp  rbx, rax\n`
STR s_mov_rbx,  `    mov  rbx, rax\n`
STR s_jmp,      `    jmp  `
STR s_jne,      `    jne  `
STR s_je,       `    je   `
STR s_jge,      `    jge  `
STR s_jle,      `    jle  `
STR s_jg,       `    jg   `
STR s_jl,       `    jl   `
STR s_if_pre,   `if_`
STR s_us,       `_`
STR s_end_lbl,  `end`
STR s_lbl_end,  `:\n`
STR s_c_if,     `    ; if\n`
STR s_c_elif,   `    ; elif\n`
STR s_c_else,   `    ; else\n`
STR s_c_while,  `    ; while\n`
STR s_c_until,  `    ; until\n`
STR s_c_for,    `    ; for\n`
STR s_lp_pre,   `lp_`
STR s_lp_top,   `_top`
STR s_lp_tgt,   `_tgt`
STR s_lp_up,    `_up`
STR s_cmp_rax_m, `    cmp  rax, [`
STR s_dec_m,    `    dec  qword [`
STR s_inc_m,    `    inc  qword [`
neg_tab: db 0, 2, 1, 6, 5, 4, 3     ; the opposite comparison: == <-> !=, < <-> >=, > <-> <=

STR s_rt_text, `\nsection .bss\nrt_sb:     resb 8 + LSTR_CAP            ; text builder, same layout as an lstr: [length][bytes]\nrt_numbuf: resb 24\nsection .text\nrt_err_cap:\n    mov  ecx, 0x203             ; text is longer than LSTR_CAP\n    jmp  rt_die\nrt_err_fit:\n    mov  ecx, 0x204             ; text does not fit in a str (8 characters)\n    jmp  rt_die\n\nrt_sb_clear:\n    mov  qword [rt_sb], 0\n    ret\n\nrt_sb_space:\n    mov  rcx, [rt_sb]\n    cmp  rcx, LSTR_CAP\n    jae  rt_err_cap\n    lea  rdx, [rt_sb + 8]\n    mov  byte [rdx + rcx], ' '\n    inc  rcx\n    mov  [rt_sb], rcx\n    ret\n\nrt_sb_str:                      ; rax = str: append its characters\n    mov  rcx, [rt_sb]\n    lea  rdx, [rt_sb + 8]\n.l: test rax, rax\n    jz   .d\n    cmp  rcx, LSTR_CAP\n    jae  rt_err_cap\n    mov  [rdx + rcx], al\n    inc  rcx\n    shr  rax, 8\n    jmp  .l\n.d: mov  [rt_sb], rcx\n    ret\n\nrt_sb_lstr:                     ; rdx = &lstr: append its text\n    mov  r8, [rdx]\n    mov  rcx, [rt_sb]\n    lea  rax, [rcx + r8]\n    cmp  rax, LSTR_CAP\n    ja   rt_err_cap\n    mov  [rt_sb], rax\n    lea  r9, [rt_sb + 8]\n    add  r9, rcx\n    add  rdx, 8\n    xor  eax, eax\n.l: cmp  rax, r8\n    jae  .d\n    mov  r10b, [rdx + rax]\n    mov  [r9 + rax], r10b\n    inc  rax\n    jmp  .l\n.d: ret\n\nrt_str_to_sb:                   ; rax = str -> rax = &text builder holding it\n    mov  qword [rt_sb], 0\n    call rt_sb_str\n    lea  rax, [rt_sb]\n    ret\n\nrt_lstr_set:                    ; rcx = &destination lstr, rdx = &source lstr\n    mov  r8, [rdx]\n    cmp  r8, LSTR_CAP\n    ja   rt_err_cap\n    mov  [rcx], r8\n    add  rcx, 8\n    add  rdx, 8\n    xor  eax, eax\n.l: cmp  rax, r8\n    jae  .d\n    mov  r9b, [rdx + rax]\n    mov  [rcx + rax], r9b\n    inc  rax\n    jmp  .l\n.d: ret\n\nrt_lstr_append:                 ; rcx = &destination lstr, rdx = &source lstr: dest += source\n    mov  r8, [rdx]\n    mov  r9, [rcx]\n    lea  rax, [r9 + r8]\n    cmp  rax, LSTR_CAP\n    ja   rt_err_cap\n    mov  [rcx], rax\n    lea  r10, [rcx + r9 + 8]\n    add  rdx, 8\n    xor  eax, eax\n.l: cmp  rax, r8\n    jae  .d\n    mov  r11b, [rdx + rax]\n    mov  [r10 + rax], r11b\n    inc  rax\n    jmp  .l\n.d: ret\n\nrt_to_str:                      ; rax = &lstr -> rax = str (at most 8 characters)\n    mov  rcx, [rax]\n    cmp  rcx, 8\n    ja   rt_err_fit\n    xor  edx, edx\n    lea  r8, [rax + 8]\n.l: test rcx, rcx\n    jz   .d\n    dec  rcx\n    movzx r9d, byte [r8 + rcx]\n    shl  rdx, 8\n    or   rdx, r9\n    jmp  .l\n.d: mov  rax, rdx\n    ret\n`
STR s_rt_num, `\nrt_sb_num:                      ; rax = signed number: append its decimal digits\n    lea  r9, [rt_numbuf + 24]\n    mov  r10, rax\n    test rax, rax\n    jns  .pos\n    neg  rax\n.pos:\n    mov  r11d, 10\n.dig:\n    xor  edx, edx\n    div  r11\n    add  dl, '0'\n    dec  r9\n    mov  [r9], dl\n    test rax, rax\n    jnz  .dig\n    test r10, r10\n    jns  .emit\n    dec  r9\n    mov  byte [r9], '-'\n.emit:\n    lea  rdx, [rt_numbuf + 24]\n    sub  rdx, r9\n    mov  rcx, [rt_sb]\n    lea  rax, [rcx + rdx]\n    cmp  rax, LSTR_CAP\n    ja   rt_err_cap\n    mov  [rt_sb], rax\n    lea  r8, [rt_sb + 8]\n    add  r8, rcx\n    xor  eax, eax\n.c: cmp  rax, rdx\n    jae  .d\n    mov  r10b, [r9 + rax]\n    mov  [r8 + rax], r10b\n    inc  rax\n    jmp  .c\n.d: ret\n`
STR s_lea_rax,   `    lea  rax, [`
STR s_lea_rax_sb, `    lea  rax, [rt_sb]\n`
STR s_mov_rdx_rax, `    mov  rdx, rax\n`
STR s_mov_rax_rbx, `    mov  rax, rbx\n`
STR s_add_rax_rbx, `    add  rax, rbx\n`
STR s_add_m,     `    add  [`
STR s_sub_m,     `    sub  [`
STR s_call_sb_clear, `    call rt_sb_clear\n`
STR s_call_sb_space, `    call rt_sb_space\n`
STR s_call_sb_str,   `    call rt_sb_str\n`
STR s_call_sb_lstr,  `    call rt_sb_lstr\n`
STR s_call_sb_num,   `    call rt_sb_num\n`
STR s_call_str_to_sb, `    call rt_str_to_sb\n`
STR s_call_lstr_set, `    call rt_lstr_set\n`
STR s_call_lstr_app, `    call rt_lstr_append\n`
STR s_call_to_str,   `    call rt_to_str\n`
STR s_times,     `    times `
STR s_db0,       ` db 0\n`
STR s_lit_pre,   `lit_`

%macro EMIT 1
    lea  rdx, [%1]
    mov  r8d, %1_len
    call emit_bytes
%endmacro

; call a runtime helper on the list in ls_name, and note that it is needed
%macro LS_CALL 2
    EMIT s_lea_rcx
    call emit_label_ls
    EMIT s_rbr_nl
    or   dword [rt_need], %1
    EMIT %2
%endmacro

; copy a runtime helper into the output if the program uses it
; call a runtime helper (which has to be copied into the output)
%macro RTCALL 2
    or   dword [rt_need], %1
    EMIT %2
%endmacro

%macro RT_IF 2
    test dword [rt_need], %1
    jz   %%skip
    EMIT %2
%%skip:
%endmacro

section .text

; ---- statement writers ------------------------------------------------------

; Declaration of the variable described by the vd_* block.
;   num / str : 8-byte slot in .bss, plus code that stores the initial value.
;               (an uninitialised num is already 0; an uninitialised str is '0')
;   lstr      : in .data as  [8-byte length][payload bytes]
; Sticky and temporary variables are emitted identically: "temporary" only
; matters for the compiler's variable table, not for the generated program.
; TODO: once scopes exist and a name can be declared again after its tvar was
;       purged, give temporaries a unique label suffix (v_x would be defined twice).
write_var:
    cmp  byte [vd_type], 2
    je   .lstr
    EMIT s_sec_bss
    call emit_label
    EMIT s_resq
    EMIT s_sec_text
    cmp  byte [vd_init_kind], 2
    je   .store2
    cmp  byte [vd_init_kind], 0
    jne  .expr                  ; initialiser is a value expression
    cmp  byte [vd_type], 0
    jne  .init                  ; str: always written (default is '0')
    cmp  byte [vd_has_init], 0
    je   .done
.init:
    EMIT s_mov_rax
    mov  rax, [vd_value]
    call emit_dec
    EMIT s_store_a
    call emit_label
    EMIT s_store_b
    ret
.store2:                       ; an expression computed before the declaration: the value is in rax
    mov  rax, [vd_name]
    mov  [st_name], rax
    mov  rax, [vd_len]
    mov  [st_len], rax
    movzx eax, byte [vd_type]
    mov  [st_type], al
    jmp  write_store
.expr:
    call write_expr             ; leaves the value in rax
    EMIT s_store_c
    call emit_label
    EMIT s_store_b
    ret

.lstr:
    EMIT s_sec_data
    call emit_label
    call emit_lstr_body
    EMIT s_sec_text
    cmp  byte [vd_init_kind], 2
    je   .store2
    ret
.done:
    ret

; list num|str name:  [count][LIST_CAP entries] in .bss, count starts at 0
write_list_decl:
    EMIT s_sec_bss
    call emit_label
    EMIT s_reslist
    EMIT s_sec_text
    ret

; list.NAME.<op>: the operands are already loaded (rdx = index, r8 = value)
write_list_op:
    movzx eax, byte [ls_op]
    cmp  eax, LS_CLEAR
    je   .clear
    cmp  eax, LS_SORT
    je   .sort
    cmp  eax, LS_APPEND
    je   .append
    cmp  eax, LS_INSERT
    je   .insert
    LS_CALL RT_LIST_REMOVE, s_call_remove
    ret
.append:
    LS_CALL RT_LIST_APPEND, s_call_append
    ret
.insert:
    LS_CALL RT_LIST_INSERT, s_call_insert
    ret
.clear:
    EMIT s_clear_a
    call emit_label_ls
    EMIT s_clear_b
    ret
.sort:
    cmp  byte [ls_type], 3
    jne  .sort_str
    LS_CALL RT_SORT_NUM, s_call_sort_num
    ret
.sort_str:
    LS_CALL RT_SORT_STR, s_call_sort_str
    ret

; Operands. write_load_idx -> "mov rdx, <operand>", write_load_val -> "mov r8, <operand>"
write_load_idx:
    EMIT s_mov_rdx
    jmp  write_opd
write_load_val:
    EMIT s_mov_r8
write_opd:                      ; the operand (a number or [v_name]) and a newline
    cmp  byte [opd_kind], 0
    jne  .var
    mov  rax, [opd_imm]
    call emit_dec
    EMIT s_nl
    ret
.var:
    EMIT s_lbr
    mov  rdx, [opd_name]
    mov  r8, [opd_len]
    call emit_label_p
    EMIT s_rbr_nl
    ret

; Code that leaves the value of the var initialiser (expr_kind) in rax.
write_expr:
    movzx eax, byte [expr_kind]
    cmp  eax, EX_COPY
    je   .copy
    cmp  eax, EX_LSTR_LEN       ; an lstr's label holds its length
    je   .load
    cmp  eax, EX_LIST_LEN       ; a list's label holds its count
    je   .load
    cmp  eax, EX_STR_LEN
    je   .str_len
    cmp  eax, EX_STR_IDX
    je   .str_idx
    cmp  eax, EX_LSTR_IDX
    je   .lstr_idx
    ; EX_LIST_IDX
    call write_load_idx
    call .lea_rcx
    or   dword [rt_need], RT_LIST_GET
    EMIT s_call_get
    ret
.copy:
    cmp  byte [expr_type], 2    ; an lstr's value is its address
    jne  .load
    EMIT s_lea_rax
    call emit_label_expr
    EMIT s_rbr_nl
    ret
.load:                          ; mov rax, [v_name]
    EMIT s_mov_rax_b
    call emit_label_expr
    EMIT s_rbr_nl
    ret
.str_len:
    call .load
    or   dword [rt_need], RT_STR_LEN
    EMIT s_call_str_len
    ret
.str_idx:
    call write_load_idx
    call .load
    or   dword [rt_need], RT_STR_IDX
    EMIT s_call_str_idx
    ret
.lstr_idx:
    call write_load_idx
    call .lea_rcx
    or   dword [rt_need], RT_LSTR_IDX
    EMIT s_call_lstr_idx
    ret
.lea_rcx:                       ; lea rcx, [v_name]
    EMIT s_lea_rcx
    call emit_label_expr
    EMIT s_rbr_nl
    ret

; ---- if / elif / else ----------------------------------------------------------
; Labels are if_<chain>_<k> (the start of branch k+1) and if_<chain>_end; [cb_chain] / [cb_k] hold the numbers.
write_comment_if:
    EMIT s_c_if
    ret
write_comment_elif:
    EMIT s_c_elif
    ret
write_comment_else:
    EMIT s_c_else
    ret

write_mov_rbx_rax:
    EMIT s_mov_rbx
    ret

write_mov_rax_imm:              ; mov rax, [cmp_imm]
    EMIT s_mov_rax
    mov  rax, [cmp_imm]
    call emit_dec
    EMIT s_nl
    ret

; cmp rbx, rax  +  a jump to if_<chain>_<k> when the condition [cond_op] is FALSE (signed compare)
write_cmp_jump:
    EMIT s_cmp_rr
    movzx eax, byte [cond_op]
    cmp  byte [cond_neg], 0     ; until: leave the loop when the condition is TRUE
    je   .op
    lea  rdx, [neg_tab]
    movzx eax, byte [rdx + rax]
    mov  byte [cond_neg], 0
.op:
    cmp  eax, 1
    je   .eq
    cmp  eax, 2
    je   .ne
    cmp  eax, 3
    je   .lt
    cmp  eax, 4
    je   .gt
    cmp  eax, 5
    je   .le
    EMIT s_jl                   ; >=
    jmp  .target
.eq:
    EMIT s_jne
    jmp  .target
.ne:
    EMIT s_je
    jmp  .target
.lt:
    EMIT s_jge
    jmp  .target
.gt:
    EMIT s_jle
    jmp  .target
.le:
    EMIT s_jg
.target:
    call emit_if_label_next
    EMIT s_nl
    ret

emit_if_label_next:             ; if_<chain>_<k>
    EMIT s_if_pre
    mov  eax, [cb_chain]
    call emit_dec
    EMIT s_us
    mov  eax, [cb_k]
    jmp  emit_dec

write_label_next:               ; if_<chain>_<k>:
    call emit_if_label_next
    EMIT s_lbl_end
    ret

write_label_end:                ; if_<chain>_end:
    EMIT s_if_pre
    mov  eax, [cb_chain]
    call emit_dec
    EMIT s_us
    EMIT s_end_lbl
    EMIT s_lbl_end
    ret

write_jmp_end:                  ; jmp if_<chain>_end
    EMIT s_jmp
    EMIT s_if_pre
    mov  eax, [cb_chain]
    call emit_dec
    EMIT s_us
    EMIT s_end_lbl
    EMIT s_nl
    ret

; ---- text and assignments ----------------------------------------------------------------
; the body of an lstr in .data: [length][bytes], padded with zeros up to LSTR_CAP so it can grow
emit_lstr_body:
    cmp  qword [vd_lit_len], LSTR_MAX
    ja   .toobig
    EMIT s_dq
    mov  rax, [vd_lit_len]
    call emit_dec
    EMIT s_nl
    cmp  qword [vd_lit_len], 0
    je   .pad
    EMIT s_db
    mov  rdi, [vd_lit_ptr]
    xor  ebx, ebx
.byte:
    movzx eax, byte [rdi + rbx] ; bytes are written as decimals: no quoting problems
    call emit_dec
    inc  rbx
    cmp  rbx, [vd_lit_len]
    jae  .bytes_done
    EMIT s_comma
    jmp  .byte
.bytes_done:
    EMIT s_nl
.pad:
    cmp  qword [vd_lit_len], LSTR_MAX
    jae  .ret
    EMIT s_times
    mov  rax, LSTR_MAX
    sub  rax, [vd_lit_len]
    call emit_dec
    EMIT s_db0
.ret:
    ret
.toobig:
    mov  bx, ERR_LSTR_TOO_BIG
    jmp  error

; a text literal longer than 8 characters: a constant lstr  lit_<n>;  rax = its address
write_lit_lstr:
    inc  dword [lit_ctr]
    EMIT s_sec_data
    EMIT s_lit_pre
    mov  eax, [lit_ctr]
    call emit_dec
    call emit_lstr_body
    EMIT s_sec_text
    EMIT s_lea_rax
    EMIT s_lit_pre
    mov  eax, [lit_ctr]
    call emit_dec
    EMIT s_rbr_nl
    ret

write_add_rbx:                  ; rax = rax + rbx
    EMIT s_add_rax_rbx
    ret

write_sb_start:                 ; text builder := the value so far (rax, type [ex_cur])
    RTCALL RT_TEXT, s_call_sb_clear
    movzx eax, byte [ex_cur]
    jmp  write_sb_append_t
write_sb_append:                ; append the value in rax (type AL) to the text builder
    movzx eax, al
write_sb_append_t:
    test eax, eax
    jz   .num
    cmp  eax, 1
    je   .str
    EMIT s_mov_rdx_rax
    RTCALL RT_TEXT, s_call_sb_lstr
    ret
.str:
    RTCALL RT_TEXT, s_call_sb_str
    ret
.num:
    RTCALL RT_TEXT | RT_TEXT_NUM, s_call_sb_num
    ret
write_sb_space:
    RTCALL RT_TEXT, s_call_sb_space
    ret
write_sb_result:                ; rax = &text builder
    EMIT s_lea_rax_sb
    ret

emit_label_st:                  ; v_<[st_name]>
    mov  rdx, [st_name]
    mov  r8, [st_len]
    jmp  emit_label_p

; Stores the value in rax (type [ex_type]) into the variable [st_name] / [st_len] of type [st_type].
write_store:
    movzx eax, byte [st_type]
    test eax, eax
    jz   .plain
    cmp  eax, 1
    je   .to_str
    cmp  byte [ex_type], 1      ; lstr <- str: put the characters in the builder first
    jne  .set
    RTCALL RT_TEXT, s_call_str_to_sb
.set:
    EMIT s_lea_rcx
    call emit_label_st
    EMIT s_rbr_nl
    EMIT s_mov_rdx_rax
    RTCALL RT_TEXT, s_call_lstr_set
    ret
.to_str:
    cmp  byte [ex_type], 2      ; str <- lstr: has to fit in 8 characters
    jne  .plain
    RTCALL RT_TEXT, s_call_to_str
.plain:
    EMIT s_store_c
    call emit_label_st
    EMIT s_store_b
    ret

; x = / += / -=   (the value is in rax)
write_assign:
    movzx eax, byte [as_kind]
    test eax, eax
    jz   write_store
    cmp  byte [st_type], 0
    jne  .text
    cmp  eax, 1
    jne  .sub
    EMIT s_add_m
    call emit_label_st
    EMIT s_store_b
    ret
.sub:
    EMIT s_sub_m
    call emit_label_st
    EMIT s_store_b
    ret
.text:                          ; += on text
    cmp  byte [st_type], 2
    jne  .str_app
    cmp  byte [ex_type], 1
    jne  .la
    RTCALL RT_TEXT, s_call_str_to_sb
.la:
    EMIT s_lea_rcx
    call emit_label_st
    EMIT s_rbr_nl
    EMIT s_mov_rdx_rax
    RTCALL RT_TEXT, s_call_lstr_app
    ret
.str_app:                       ; str += text: build old + new in the builder, it has to fit again
    EMIT s_mov_rbx
    RTCALL RT_TEXT, s_call_sb_clear
    EMIT s_mov_rax_b
    call emit_label_st
    EMIT s_rbr_nl
    RTCALL RT_TEXT, s_call_sb_str
    EMIT s_mov_rax_rbx
    cmp  byte [ex_type], 1
    jne  .sl
    RTCALL RT_TEXT, s_call_sb_str
    jmp  .fin
.sl:
    EMIT s_mov_rdx_rax
    RTCALL RT_TEXT, s_call_sb_lstr
.fin:
    EMIT s_lea_rax_sb
    RTCALL RT_TEXT, s_call_to_str
    EMIT s_store_c
    call emit_label_st
    EMIT s_store_b
    ret

; ---- while / until / for -------------------------------------------------------------
; Labels: lp_<chain>_top (the test), lp_<chain>_tgt (for: the target), lp_<chain>_up, and if_<chain>_1 (the exit).
%macro LPL 1
    EMIT s_lp_pre
    mov  eax, [cb_chain]
    call emit_dec
    EMIT %1
%endmacro

write_comment_loop:             ; in: EAX = FN_WHILE / FN_UNTIL
    cmp  eax, FN_WHILE
    jne  .u
    EMIT s_c_while
    ret
.u: EMIT s_c_until
    ret
write_comment_for:
    EMIT s_c_for
    ret

write_loop_top:                 ; lp_<chain>_top:
    LPL  s_lp_top
    EMIT s_lbl_end
    ret

write_jmp_top:                  ; jmp lp_<chain>_top
    EMIT s_jmp
    LPL  s_lp_top
    EMIT s_nl
    ret

write_for_decl:                 ; lp_<chain>_tgt: resq 1   (in .bss)
    EMIT s_sec_bss
    LPL  s_lp_tgt
    EMIT s_resq
    EMIT s_sec_text
    ret

emit_for_var:                   ; v_<loop variable>
    mov  rdx, [fo_name]
    mov  r8, [fo_len]
    jmp  emit_label_p

; the target is in rax: store it, then the test at the top of the loop
write_for_head:
    EMIT s_store_c
    LPL  s_lp_tgt
    EMIT s_store_b
    call write_loop_top
    EMIT s_mov_rax_b
    call emit_for_var
    EMIT s_rbr_nl
    EMIT s_cmp_rax_m
    LPL  s_lp_tgt
    EMIT s_rbr_nl
    EMIT s_je
    call emit_if_label_next
    EMIT s_nl
    ret

; the end of a for body: one step toward the target, then back to the test
write_for_step:
    EMIT s_mov_rax_b
    call emit_for_var
    EMIT s_rbr_nl
    EMIT s_cmp_rax_m
    LPL  s_lp_tgt
    EMIT s_rbr_nl
    EMIT s_jl
    LPL  s_lp_up
    EMIT s_nl
    EMIT s_dec_m
    call emit_for_var
    EMIT s_rbr_nl
    call write_jmp_top
    LPL  s_lp_up
    EMIT s_lbl_end
    EMIT s_inc_m
    call emit_for_var
    EMIT s_rbr_nl
    jmp  write_jmp_top

; Any other statement: not compiled yet, leave a marker so the output shows it.
; in: R14D = FN_* flag
write_func:
    EMIT s_todo
    mov  eax, r14d
    call emit_dec
    EMIT s_nl
    ret

; ---- output file ------------------------------------------------------------

out_begin:
    mov  qword [out_len], 0
    mov  dword [rt_need], 0
    EMIT s_header
    ret

out_end:                        ; footer, runtime helpers, then write the file
    EMIT s_footer
    cmp  dword [rt_need], 0
    je   out_flush
    EMIT s_rt_common
    RT_IF RT_STR_LEN,     s_rt_str_len
    RT_IF RT_STR_IDX,     s_rt_str_idx
    RT_IF RT_LSTR_IDX,    s_rt_lstr_idx
    RT_IF RT_LIST_APPEND, s_rt_append
    RT_IF RT_LIST_INSERT, s_rt_insert
    RT_IF RT_LIST_REMOVE, s_rt_remove
    RT_IF RT_LIST_GET,    s_rt_get
    RT_IF RT_SORT_NUM,    s_rt_sort_num
    RT_IF RT_SORT_STR,    s_rt_sort_str
    RT_IF RT_TEXT,        s_rt_text
    RT_IF RT_TEXT_NUM,    s_rt_num
    ; fall through

out_flush:
    push rbx
    sub  rsp, 64                ; entry rsp is 8 mod 16: push + 64 keeps calls aligned
    call build_out_path
    lea  rcx, [out_path]
    mov  edx, 0x40000000        ; GENERIC_WRITE
    xor  r8d, r8d
    xor  r9d, r9d
    mov  qword [rsp + 32], 2    ; CREATE_ALWAYS
    mov  qword [rsp + 40], 0x80 ; FILE_ATTRIBUTE_NORMAL
    mov  qword [rsp + 48], 0
    call CreateFileA
    cmp  rax, -1
    je   .fail
    mov  [out_handle], rax

    mov  rcx, rax
    lea  rdx, [out_buf]
    mov  r8d, [out_len]
    lea  r9, [out_written]
    mov  qword [out_written], 0
    mov  qword [rsp + 32], 0
    call WriteFile
    mov  ebx, eax               ; RBX is non-volatile: survives CloseHandle
    mov  rcx, [out_handle]
    call CloseHandle
    test ebx, ebx
    jz   .fail
    mov  rax, [out_written]
    cmp  rax, [out_len]
    jne  .fail
    add  rsp, 64
    pop  rbx
    ret
.fail:
    mov  bx, ERR_WRITE_FAILED
    jmp  error

; out_path = path_buf with its extension replaced by ".nasm".
; (the opener guarantees the last '.' of path_buf starts the extension)
build_out_path:
    lea  rdx, [path_buf]
    lea  r8, [out_path]
    xor  r9d, r9d               ; position of the last '.'
.copy:
    mov  al, [rdx]
    test al, al
    jz   .copied
    mov  [r8], al
    cmp  al, '.'
    jne  .next
    mov  r9, r8
.next:
    inc  rdx
    inc  r8
    jmp  .copy
.copied:
    test r9, r9
    cmovz r9, r8                ; (no dot: just append)
    mov  dword [r9], '.nas'
    mov  word  [r9 + 4], 'm'    ; 'm', 0
    ret

; ---- emit primitives --------------------------------------------------------

; in: RDX = bytes, R8 = count
emit_bytes:
    mov  rax, [out_len]
    lea  rcx, [rax + r8]
    cmp  rcx, OUT_SIZE
    ja   .full
    lea  r9, [out_buf]
    add  r9, rax
    xor  r10d, r10d
.copy:
    cmp  r10, r8
    jae  .done
    mov  r11b, [rdx + r10]
    mov  [r9 + r10], r11b
    inc  r10
    jmp  .copy
.done:
    mov  [out_len], rcx
    ret
.full:
    mov  bx, ERR_OUTPUT_FULL
    jmp  error

; in: RAX = unsigned value -> decimal text
emit_dec:
    lea  r9, [num_buf + 24]
    mov  r10, r9
    mov  ecx, 10
.digit:
    xor  edx, edx
    div  rcx
    add  dl, '0'
    dec  r9
    mov  [r9], dl
    test rax, rax
    jnz  .digit
    mov  rdx, r9
    mov  r8, r10
    sub  r8, r9
    jmp  emit_bytes

; The NASM label of a variable: v_<name>   (e.g. x -> v_x, __x -> v___x)
; emit_label = the declared variable (vd_*), emit_label_expr = expr_*, emit_label_ls = ls_*,
; emit_label_p = RDX = name, R8 = length
emit_label:
    mov  rdx, [vd_name]
    mov  r8, [vd_len]
    jmp  emit_label_p
emit_label_expr:
    mov  rdx, [expr_name]
    mov  r8, [expr_len]
    jmp  emit_label_p
emit_label_ls:
    mov  rdx, [ls_name]
    mov  r8, [ls_len]
emit_label_p:
    mov  [lbl_ptr], rdx
    mov  [lbl_len], r8
    EMIT s_vpre                 ; (clobbers RDX / R8)
    mov  rdx, [lbl_ptr]
    mov  r8, [lbl_len]
    jmp  emit_bytes
