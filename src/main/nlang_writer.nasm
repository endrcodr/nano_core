STR s_ca_decl,   `:  resb 8 + LSTR_CAP\n`
STR s_b_nl2x,    `_b\n`
STR s_b_lbl2,    `_b:\n`

STR s_rt_bin, `\nsection .bss\nrt_bacc:   resb 8 + BIN_BYTES           ; accumulator for bit operations: [length in bits][bits]\nrt_bt:     resb 16\nsection .text\n\nrt_bin_set:                     ; rcx = &destination, rdx = &source: destination := source\n    mov  r8, [rdx]\n    mov  [rcx], r8\n    add  r8, 7\n    shr  r8, 3                  ; bytes\n    add  rcx, 8\n    add  rdx, 8\n    xor  eax, eax\n.l: cmp  rax, r8\n    jae  .d\n    mov  r9b, [rdx + rax]\n    mov  [rcx + rax], r9b\n    inc  rax\n    jmp  .l\n.d: ret\n\nrt_bin_op:                      ; rcx = &accumulator, rdx = &operand, r8d: 0 and, 1 or, 2 xor, +4 = invert the result\n    push rbx\n    push rsi\n    push rdi\n    mov  rsi, [rcx]             ; length of the accumulator\n    mov  rdi, [rdx]             ; length of the operand\n    mov  rbx, rsi\n    cmp  rdi, rbx\n    jbe  .1\n    mov  rbx, rdi               ; the result is as long as the longer one\n.1: mov  r9, rsi\n    add  r9, 7\n    shr  r9, 3                  ; bytes of the accumulator\n    mov  r10, rdi\n    add  r10, 7\n    shr  r10, 3                 ; bytes of the operand\n    mov  rsi, rbx               ; rsi = length of the result\n    add  rbx, 7\n    shr  rbx, 3\n    mov  r11, rbx               ; r11 = bytes of the result\n    xor  edi, edi               ; byte number\n.l: cmp  rdi, r11\n    jae  .fin\n    xor  eax, eax\n    cmp  rdi, r9\n    jae  .nb\n    movzx eax, byte [rcx + rdi + 8]\n.nb:\n    xor  ebx, ebx\n    cmp  rdi, r10\n    jae  .ab\n    movzx ebx, byte [rdx + rdi + 8]\n.ab:\n    test r8b, 2\n    jnz  .xor\n    test r8b, 1\n    jnz  .or\n    and  eax, ebx\n    jmp  .inv\n.or:\n    or   eax, ebx\n    jmp  .inv\n.xor:\n    xor  eax, ebx\n.inv:\n    test r8b, 4\n    jz   .st\n    not  eax\n.st:\n    mov  [rcx + rdi + 8], al\n    inc  rdi\n    jmp  .l\n.fin:\n    mov  [rcx], rsi\n    mov  rdi, rcx\n    mov  ecx, esi\n    and  ecx, 7\n    jz   .done\n    mov  ebx, 1                 ; clear the unused bits of the last byte\n    shl  ebx, cl\n    dec  ebx\n    and  [rdi + r11 + 7], bl\n.done:\n    pop  rdi\n    pop  rsi\n    pop  rbx\n    ret\n\nrt_bin_not:                     ; rcx = &bin: every bit flipped\n    mov  rdx, [rcx]\n    lea  r8, [rdx + 7]\n    shr  r8, 3\n    xor  eax, eax\n.l: cmp  rax, r8\n    jae  .m\n    not  byte [rcx + rax + 8]\n    inc  rax\n    jmp  .l\n.m: mov  r9, rcx\n    mov  ecx, edx\n    and  ecx, 7\n    jz   .d\n    mov  edx, 1\n    shl  edx, cl\n    dec  edx\n    and  [r9 + r8 + 7], dl\n.d: ret\n\nrt_bin_eq:                      ; rcx = &a, rdx = &b -> eax = 1 when they are equal (zero-padded on the left)\n    push rbx\n    mov  r8, [rcx]\n    add  r8, 7\n    shr  r8, 3\n    mov  r9, [rdx]\n    add  r9, 7\n    shr  r9, 3\n    mov  r10, r8\n    cmp  r9, r10\n    jbe  .1\n    mov  r10, r9\n.1: xor  r11d, r11d\n.l: cmp  r11, r10\n    jae  .yes\n    xor  eax, eax\n    cmp  r11, r8\n    jae  .a0\n    movzx eax, byte [rcx + r11 + 8]\n.a0:\n    xor  ebx, ebx\n    cmp  r11, r9\n    jae  .b0\n    movzx ebx, byte [rdx + r11 + 8]\n.b0:\n    cmp  eax, ebx\n    jne  .no\n    inc  r11\n    jmp  .l\n.yes:\n    mov  eax, 1\n    pop  rbx\n    ret\n.no:\n    xor  eax, eax\n    pop  rbx\n    ret\n\nrt_bin_idx:                     ; rcx = &bin, rdx = bit number -> eax = 0 / 1\n    cmp  rdx, [rcx]\n    jae  rt_err_range\n    mov  r8, rcx\n    mov  rax, rdx\n    shr  rax, 3\n    movzx eax, byte [r8 + rax + 8]\n    mov  ecx, edx\n    and  ecx, 7\n    shr  eax, cl\n    and  eax, 1\n    ret\n\nrt_bin_from_num:                ; rax = number -> rax = &bin of its 64 bits\n    lea  rcx, [rt_bt]\n    mov  qword [rcx], 64\n    mov  [rcx + 8], rax\n    mov  rax, rcx\n    ret\n\nrt_bin_to_num:                  ; rax = &bin -> rax = its lowest 64 bits\n    mov  rcx, [rax]\n    add  rcx, 7\n    shr  rcx, 3\n    cmp  rcx, 8\n    jbe  .1\n    mov  ecx, 8\n.1: xor  edx, edx\n.l: test rcx, rcx\n    jz   .d\n    dec  rcx\n    shl  rdx, 8\n    movzx r8d, byte [rax + rcx + 8]\n    or   rdx, r8\n    jmp  .l\n.d: mov  rax, rdx\n    ret\n\n`
STR s_rt_sbbin, `\nrt_sb_bin:                      ; rdx = &bin: append  0b  and its bits, most significant first\n    mov  r8, [rdx]\n    mov  rcx, [rt_sb]\n    lea  rax, [rcx + r8 + 2]\n    cmp  rax, LSTR_CAP\n    ja   rt_err_cap\n    mov  [rt_sb], rax\n    lea  r9, [rt_sb + 8]\n    add  r9, rcx\n    mov  byte [r9], '0'\n    mov  byte [r9 + 1], 'b'\n    add  r9, 2\n    xor  r10d, r10d\n.l: cmp  r10, r8\n    jae  .d\n    mov  rax, r8\n    dec  rax\n    sub  rax, r10               ; number of the bit\n    mov  r11, rax\n    shr  r11, 3\n    movzx r11d, byte [rdx + r11 + 8]\n    mov  ecx, eax\n    and  ecx, 7\n    shr  r11d, cl\n    and  r11d, 1\n    add  r11d, '0'\n    mov  [r9 + r10], r11b\n    inc  r10\n    jmp  .l\n.d: ret\n`
STR s_bin_decl,   `:  dq 1\n    times BIN_BYTES db 0\n`
STR s_bin_pre,    `bin_`
STR s_bin_load,   `    mov  rdx, rax\n    lea  rcx, [rt_bacc]\n    call rt_bin_set\n`
STR s_bin_op_a,   `    mov  rdx, rax\n    lea  rcx, [rt_bacc]\n    mov  r8d, `
STR s_bin_op_b,   `\n    call rt_bin_op\n`
STR s_bin_not,    `    lea  rcx, [rt_bacc]\n    call rt_bin_not\n`
STR s_bin_res,    `    lea  rax, [rt_bacc]\n`
STR s_bin_eq,     `    mov  rdx, rax\n    mov  rcx, rbx\n    call rt_bin_eq\n    mov  rbx, rax\n    mov  eax, 1\n`
STR s_bin_set,    `    call rt_bin_set\n`
STR s_call_bin_idx, `    call rt_bin_idx\n`
STR s_bin_from,   `    call rt_bin_from_num\n`
STR s_bin_to,     `    call rt_bin_to_num\n`
STR s_sb_bin,     `    mov  rdx, rax\n    call rt_sb_bin\n`

%macro EMIT 1
    lea  rdx, [%1]
    mov  r8d, %1_len
    call emit_bytes
%endmacro

; call a runtime helper on the list in ls_name, and note that it is needed
%macro LS_CALL 2
    EMIT s_lea_rcx
    call emit_label_ls
    EMIT s_rbr_nl
    or   dword [rt_need], %1
    EMIT %2
%endmacro

; copy a runtime helper into the output if the program uses it
; call a runtime helper (which has to be copied into the output)
%macro RTCALL 2
    or   dword [rt_need], %1
    EMIT %2
%endmacro

%macro RT_IF 2
    test dword [rt_need], %1
    jz   %%skip
    EMIT %2
%%skip:
%endmacro

section .text

; ---- statement writers ------------------------------------------------------

; Declaration of the variable described by the vd_* block.
;   num / str : 8-byte slot in .bss, plus code that stores the initial value.
;               (an uninitialised num is already 0; an uninitialised str is '0')
;   lstr      : in .data as  [8-byte length][payload bytes]
; Sticky and temporary variables are emitted identically: "temporary" only
; matters for the compiler's variable table, not for the generated program.
; TODO: once scopes exist and a name can be declared again after its tvar was
;       purged, give temporaries a unique label suffix (v_x would be defined twice).
write_var:
    cmp  byte [vd_type], 5
    je   .bin
    cmp  byte [vd_type], 2
    je   .lstr
    EMIT s_sec_bss
    call emit_label
    EMIT s_resq
    EMIT s_sec_text
    cmp  byte [vd_init_kind], 2
    je   .store2
    cmp  byte [vd_init_kind], 0
    jne  .expr                  ; initialiser is a value expression
    cmp  byte [vd_type], 0
    jne  .init                  ; str: always written (default is '0')
    cmp  qword [cur_fn], 0
    jne  .init                  ; a local starts from 0 on every call
    cmp  byte [vd_has_init], 0
    je   .done
.init:
    EMIT s_mov_rax
    mov  rax, [vd_value]
    call emit_dec
    EMIT s_store_a
    call emit_label
    EMIT s_store_b
    ret
.bin:                           ; [length in bits][bits], padded so it can grow; the default is 0b0
    EMIT s_sec_data
    call emit_label
    EMIT s_bin_decl
    EMIT s_sec_text
    cmp  byte [vd_init_kind], 2
    je   .store2
    ret
.store2:                       ; an expression computed before the declaration: the value is in rax
    mov  rax, [vd_name]
    mov  [st_name], rax
    mov  rax, [vd_len]
    mov  [st_len], rax
    movzx eax, byte [vd_type]
    mov  [st_type], al
    jmp  write_store
.expr:
    call write_expr             ; leaves the value in rax
    EMIT s_store_c
    call emit_label
    EMIT s_store_b
    ret

.lstr:
    EMIT s_sec_data
    call emit_label
    call emit_lstr_body
    EMIT s_sec_text
    cmp  byte [vd_init_kind], 2
    je   .store2
    cmp  qword [cur_fn], 0
    je   .done
    call write_lit_lstr         ; a local lstr gets its initial text again on every call
    mov  byte [ex_type], 2
    jmp  .store2
.done:
    ret

; list num|str name:  [count][LIST_CAP entries] in .bss, count starts at 0
write_list_decl:
    EMIT s_sec_bss
    call emit_label
    EMIT s_reslist
    EMIT s_sec_text
    cmp  qword [cur_fn], 0
    je   .ret
    EMIT s_clear_a              ; a local list starts empty on every call
    call emit_label
    EMIT s_clear_b
.ret:
    ret

; list.NAME.<op>: the operands are already loaded (rdx = index, r8 = value)
write_list_op:
    movzx eax, byte [ls_op]
    cmp  eax, LS_CLEAR
    je   .clear
    cmp  eax, LS_SORT
    je   .sort
    cmp  eax, LS_APPEND
    je   .append
    cmp  eax, LS_INSERT
    je   .insert
    LS_CALL RT_LIST_REMOVE, s_call_remove
    ret
.append:
    LS_CALL RT_LIST_APPEND, s_call_append
    ret
.insert:
    LS_CALL RT_LIST_INSERT, s_call_insert
    ret
.clear:
    EMIT s_clear_a
    call emit_label_ls
    EMIT s_clear_b
    ret
.sort:
    cmp  byte [ls_type], 3
    jne  .sort_str
    LS_CALL RT_SORT_NUM, s_call_sort_num
    ret
.sort_str:
    LS_CALL RT_SORT_STR, s_call_sort_str
    ret

; Operands. write_load_idx -> "mov rdx, <operand>", write_load_val -> "mov r8, <operand>"
write_load_idx:
    EMIT s_mov_rdx
    jmp  write_opd
write_load_val:
    EMIT s_mov_r8
write_opd:                      ; the operand (a number or [v_name]) and a newline
    cmp  byte [opd_kind], 0
    jne  .var
    mov  rax, [opd_imm]
    call emit_dec
    EMIT s_nl
    ret
.var:
    EMIT s_lbr
    mov  rdx, [opd_name]
    mov  r8, [opd_len]
    call emit_label_p
    EMIT s_rbr_nl
    ret

; Code that leaves the value of the var initialiser (expr_kind) in rax.
write_expr:
    movzx eax, byte [expr_kind]
    cmp  eax, EX_COPY
    je   .copy
    cmp  eax, EX_LSTR_LEN       ; an lstr's label holds its length
    je   .load
    cmp  eax, EX_LIST_LEN       ; a list's label holds its count
    je   .load
    cmp  eax, EX_BIN_LEN        ; a bin's label holds its length in bits
    je   .load
    cmp  eax, EX_BIN_IDX
    je   .bin_idx
    cmp  eax, EX_STR_LEN
    je   .str_len
    cmp  eax, EX_STR_IDX
    je   .str_idx
    cmp  eax, EX_LSTR_IDX
    je   .lstr_idx
    ; EX_LIST_IDX
    call write_load_idx
    call .lea_rcx
    or   dword [rt_need], RT_LIST_GET
    EMIT s_call_get
    ret
.bin_idx:
    call write_load_idx
    call .lea_rcx
    RTCALL RT_BIN, s_call_bin_idx
    ret
.copy:
    cmp  byte [expr_type], 2    ; an lstr's / a bin's value is its address
    je   .addr
    cmp  byte [expr_type], 3
    jne  .load
.addr:
    EMIT s_lea_rax
    call emit_label_expr
    EMIT s_rbr_nl
    ret
.load:                          ; mov rax, [v_name]
    EMIT s_mov_rax_b
    call emit_label_expr
    EMIT s_rbr_nl
    ret
.str_len:
    call .load
    or   dword [rt_need], RT_STR_LEN
    EMIT s_call_str_len
    ret
.str_idx:
    call write_load_idx
    call .load
    or   dword [rt_need], RT_STR_IDX
    EMIT s_call_str_idx
    ret
.lstr_idx:
    call write_load_idx
    call .lea_rcx
    or   dword [rt_need], RT_LSTR_IDX
    EMIT s_call_lstr_idx
    ret
.lea_rcx:                       ; lea rcx, [v_name]
    EMIT s_lea_rcx
    call emit_label_expr
    EMIT s_rbr_nl
    ret

; ---- if / elif / else ----------------------------------------------------------
; Labels are if_<chain>_<k> (the start of branch k+1) and if_<chain>_end; [cb_chain] / [cb_k] hold the numbers.
write_comment_if:
    EMIT s_c_if
    ret
write_comment_elif:
    EMIT s_c_elif
    ret
write_comment_else:
    EMIT s_c_else
    ret

write_mov_rbx_rax:
    EMIT s_mov_rbx
    ret

write_mov_rax_imm:              ; mov rax, [cmp_imm]
    EMIT s_mov_rax
    mov  rax, [cmp_imm]
    call emit_dec
    EMIT s_nl
    ret

; cmp rbx, rax  +  a jump to if_<chain>_<k> when the condition [cond_op] is FALSE (signed compare)
write_cmp_jump:
    EMIT s_cmp_rr
    movzx eax, byte [cond_op]
    cmp  byte [cond_neg], 0     ; until: leave the loop when the condition is TRUE
    je   .op
    lea  rdx, [neg_tab]
    movzx eax, byte [rdx + rax]
    mov  byte [cond_neg], 0
.op:
    cmp  eax, 1
    je   .eq
    cmp  eax, 2
    je   .ne
    cmp  eax, 3
    je   .lt
    cmp  eax, 4
    je   .gt
    cmp  eax, 5
    je   .le
    EMIT s_jl                   ; >=
    jmp  .target
.eq:
    EMIT s_jne
    jmp  .target
.ne:
    EMIT s_je
    jmp  .target
.lt:
    EMIT s_jge
    jmp  .target
.gt:
    EMIT s_jle
    jmp  .target
.le:
    EMIT s_jg
.target:
    call emit_if_label_next
    EMIT s_nl
    ret

; cmp rbx, rax, then RAX = 1 when the condition [cond_op] holds, else 0 (signed compare)
write_setcc:
    EMIT s_cmp_rr
    movzx eax, byte [cond_op]
    cmp  eax, 1
    je   .eq
    cmp  eax, 2
    je   .ne
    cmp  eax, 3
    je   .lt
    cmp  eax, 4
    je   .gt
    cmp  eax, 5
    je   .le
    EMIT s_setge
    jmp  .z
.eq:
    EMIT s_sete
    jmp  .z
.ne:
    EMIT s_setne
    jmp  .z
.lt:
    EMIT s_setl
    jmp  .z
.gt:
    EMIT s_setg
    jmp  .z
.le:
    EMIT s_setle
.z:
    EMIT s_movzx_al
    ret

emit_if_label_next:             ; if_<chain>_<k>
    EMIT s_if_pre
    mov  eax, [cb_chain]
    call emit_dec
    EMIT s_us
    mov  eax, [cb_k]
    jmp  emit_dec

write_label_next:               ; if_<chain>_<k>:
    call emit_if_label_next
    EMIT s_lbl_end
    ret

write_label_end:                ; if_<chain>_end:
    EMIT s_if_pre
    mov  eax, [cb_chain]
    call emit_dec
    EMIT s_us
    EMIT s_end_lbl
    EMIT s_lbl_end
    ret

write_jmp_end:                  ; jmp if_<chain>_end
    EMIT s_jmp
    EMIT s_if_pre
    mov  eax, [cb_chain]
    call emit_dec
    EMIT s_us
    EMIT s_end_lbl
    EMIT s_nl
    ret

; ---- text and assignments ----------------------------------------------------------------
; the body of an lstr in .data: [length][bytes], padded with zeros up to LSTR_CAP so it can grow
emit_lstr_body:
    cmp  qword [vd_lit_len], LSTR_MAX
    ja   .toobig
    EMIT s_dq
    mov  rax, [vd_lit_len]
    call emit_dec
    EMIT s_nl
    cmp  qword [vd_lit_len], 0
    je   .pad
    EMIT s_db
    mov  rdi, [vd_lit_ptr]
    xor  ebx, ebx
.byte:
    movzx eax, byte [rdi + rbx] ; bytes are written as decimals: no quoting problems
    call emit_dec
    inc  rbx
    cmp  rbx, [vd_lit_len]
    jae  .bytes_done
    EMIT s_comma
    jmp  .byte
.bytes_done:
    EMIT s_nl
.pad:
    cmp  qword [vd_lit_len], LSTR_MAX
    jae  .ret
    EMIT s_times
    mov  rax, LSTR_MAX
    sub  rax, [vd_lit_len]
    call emit_dec
    EMIT s_db0
.ret:
    ret
.toobig:
    mov  bx, ERR_LSTR_TOO_BIG
    jmp  error

; a text literal longer than 8 characters: a constant lstr  lit_<n>;  rax = its address
write_lit_lstr:
    inc  dword [lit_ctr]
    EMIT s_sec_data
    EMIT s_lit_pre
    mov  eax, [lit_ctr]
    call emit_dec
    call emit_lstr_body
    EMIT s_sec_text
    EMIT s_lea_rax
    EMIT s_lit_pre
    mov  eax, [lit_ctr]
    call emit_dec
    EMIT s_rbr_nl
    ret

write_add_rbx:                  ; rax = rax + rbx
    EMIT s_add_rax_rbx
    ret

write_sb_start:                 ; text builder := the value so far (rax, type [ex_cur])
    RTCALL RT_TEXT, s_call_sb_clear
    movzx eax, byte [ex_cur]
    jmp  write_sb_append_t
write_sb_append:                ; append the value in rax (type AL) to the text builder
    movzx eax, al
write_sb_append_t:
    test eax, eax
    jz   .num
    cmp  eax, 1
    je   .str
    cmp  eax, 3
    je   .bin
    EMIT s_mov_rdx_rax
    RTCALL RT_TEXT, s_call_sb_lstr
    ret
.bin:
    RTCALL RT_TEXT | RT_SBBIN, s_sb_bin
    ret
.str:
    RTCALL RT_TEXT, s_call_sb_str
    ret
.num:
    RTCALL RT_TEXT | RT_TEXT_NUM, s_call_sb_num
    ret
write_sb_space:
    RTCALL RT_TEXT, s_call_sb_space
    ret
write_sb_result:                ; rax = &text builder
    EMIT s_lea_rax_sb
    ret

emit_label_st:                  ; v_<[st_name]>
    mov  rdx, [st_name]
    mov  r8, [st_len]
    jmp  emit_label_p

; Stores the value in rax (type [ex_type]) into the variable [st_name] / [st_len] of type [st_type].
write_store:
    movzx eax, byte [st_type]
    test eax, eax
    jz   .plain
    cmp  eax, 5
    je   .bin
    cmp  eax, 1
    je   .to_str
    cmp  byte [ex_type], 1      ; lstr <- str: put the characters in the builder first
    jne  .set
    RTCALL RT_TEXT, s_call_str_to_sb
.set:
    EMIT s_lea_rcx
    call emit_label_st
    EMIT s_rbr_nl
    EMIT s_mov_rdx_rax
    RTCALL RT_TEXT, s_call_lstr_set
    ret
.bin:                           ; bin := the bin whose address is in rax
    EMIT s_lea_rcx
    call emit_label_st
    EMIT s_rbr_nl
    EMIT s_mov_rdx_rax
    RTCALL RT_BIN, s_bin_set
    ret
.to_str:
    cmp  byte [ex_type], 2      ; str <- lstr: has to fit in 8 characters
    jne  .plain
    RTCALL RT_TEXT, s_call_to_str
.plain:
    EMIT s_store_c
    call emit_label_st
    EMIT s_store_b
    ret

; x = / += / -=   (the value is in rax)
write_assign:
    movzx eax, byte [as_kind]
    test eax, eax
    jz   write_store
    cmp  byte [st_type], 0
    jne  .text
    cmp  eax, 1
    jne  .sub
    EMIT s_add_m
    call emit_label_st
    EMIT s_store_b
    ret
.sub:
    EMIT s_sub_m
    call emit_label_st
    EMIT s_store_b
    ret
.text:                          ; += on text
    cmp  byte [st_type], 2
    jne  .str_app
    cmp  byte [ex_type], 1
    jne  .la
    RTCALL RT_TEXT, s_call_str_to_sb
.la:
    EMIT s_lea_rcx
    call emit_label_st
    EMIT s_rbr_nl
    EMIT s_mov_rdx_rax
    RTCALL RT_TEXT, s_call_lstr_app
    ret
.str_app:                       ; str += text: build old + new in the builder, it has to fit again
    EMIT s_mov_rbx
    RTCALL RT_TEXT, s_call_sb_clear
    EMIT s_mov_rax_b
    call emit_label_st
    EMIT s_rbr_nl
    RTCALL RT_TEXT, s_call_sb_str
    EMIT s_mov_rax_rbx
    cmp  byte [ex_type], 1
    jne  .sl
    RTCALL RT_TEXT, s_call_sb_str
    jmp  .fin
.sl:
    EMIT s_mov_rdx_rax
    RTCALL RT_TEXT, s_call_sb_lstr
.fin:
    EMIT s_lea_rax_sb
    RTCALL RT_TEXT, s_call_to_str
    EMIT s_store_c
    call emit_label_st
    EMIT s_store_b
    ret

; ---- functions -------------------------------------------------------------------------
%macro IDL 2                    ; prefix, [w_id], suffix
    EMIT %1
    mov  eax, [w_id]
    call emit_dec
    EMIT %2
%endmacro
%macro SITEL 2                  ; prefix, [w_site], suffix
    EMIT %1
    mov  eax, [w_site]
    call emit_dec
    EMIT %2
%endmacro

write_def_begin:
    mov  eax, [cur_fn_id]
    mov  [w_id], eax
    EMIT s_c_def
    mov  r8, [cur_fn]
    mov  rdx, [r8]
    mov  r8, [r8 + 8]
    call emit_bytes
    EMIT s_nl
    EMIT s_sec_bss
    IDL  s_fa, s_resq
    IDL  s_fr, s_b_lbl          ; fr_<id>_b:  start of the function's local variables (.bss)
    EMIT s_sec_data
    IDL  s_fr, s_d_lbl          ; fr_<id>_d:  ... and of its lstr locals (.data)
    EMIT s_sec_text
    ret

write_param_decl:               ; the parameter in vd_*
    cmp  byte [vd_type], 2
    je   .l
    EMIT s_sec_bss
    call emit_label
    EMIT s_resq
    EMIT s_sec_text
    ret
.l:
    EMIT s_sec_data
    call emit_label
    mov  qword [vd_lit_len], 0
    call emit_lstr_body
    EMIT s_sec_text
    ret

write_def_enter:                ; the function's code is jumped over by the surrounding code
    mov  eax, [cur_fn_id]
    mov  [w_id], eax
    EMIT s_jmp
    IDL  s_fn, s_skip_nl
    IDL  s_fn, s_lbl_end
    EMIT s_sub_rsp40
    ret

write_def_end:
    mov  eax, [cur_fn_id]
    mov  [w_id], eax
    mov  r8, [cur_fn]
    movzx eax, byte [r8 + 21]
    mov  [w_rt], al
    IDL  s_fn, s_ret_lbl
    EMIT s_add_rsp40
    EMIT s_ret_ins
    EMIT s_sec_bss
    IDL  s_fr, s_be_lbl
    EMIT s_sec_data
    IDL  s_fr, s_de_lbl
    cmp  byte [w_rt], 2
    jne  .nr
    EMIT s_sec_bss
    IDL  s_rv, s_rv_decl        ; the text a function returns is handed over in rv_<id>
.nr:
    EMIT s_sec_text
    IDL  s_fn, s_skip_lbl
    ret

write_ret_value:                ; EAX = type of the value in rax
    cmp  eax, 2
    jne  write_ret_void
    mov  eax, [cur_fn_id]
    mov  [w_id], eax
    EMIT s_mov_rdx_rax
    EMIT s_lea_rcx
    IDL  s_rv, s_rbr_nl
    or   dword [rt_need], RT_TEXT
    EMIT s_call_lstr_set
    EMIT s_lea_rax
    IDL  s_rv, s_rbr_nl
write_ret_void:
    mov  eax, [cur_fn_id]
    mov  [w_id], eax
    EMIT s_jmp
    IDL  s_fn, s_ret_nl
    ret

write_call_begin:
    EMIT s_push_rbx
    ret
write_call_end:
    EMIT s_pop_rbx
    ret
write_str_to_sb:               ; rax = str -> rax = &text builder holding it
    or   dword [rt_need], RT_TEXT
    EMIT s_call_str_to_sb
    ret
write_sb_save:
    or   dword [rt_need], RT_TEXT | RT_FRAMES | RT_SBSAVE
    EMIT s_call_sbsave
    ret
write_sb_restore:
    EMIT s_call_sbrest
    ret

emit_ca_label:                  ; ca_<site>_<arg>
    EMIT s_ca
    mov  eax, [w_site]
    call emit_dec
    EMIT s_us
    mov  eax, [w_idx]
    jmp  emit_dec

; the value of an argument (rax, type EAX, argument number ECX) goes on the stack until all of them are known
write_arg_push:
    cmp  eax, 2
    je   .text
    EMIT s_push_rax
    ret
.text:                          ; text is copied to a scratch buffer of this call site first
    mov  [w_idx], ecx
    mov  edx, [ca_n]
    cmp  edx, CA_MAX
    jae  .full
    mov  eax, [w_site]
    shl  eax, 4
    or   eax, ecx
    lea  r8, [ca_tab]
    mov  [r8 + rdx*4], eax
    inc  dword [ca_n]
    EMIT s_mov_rdx_rax
    EMIT s_lea_rcx
    call emit_ca_label
    EMIT s_rbr_nl
    or   dword [rt_need], RT_TEXT
    EMIT s_call_lstr_set
    EMIT s_lea_rax
    call emit_ca_label
    EMIT s_rbr_nl
    EMIT s_push_rax
    ret
.full:
    mov  bx, ERR_TABLE_FULL
    jmp  error

emit_param_label:               ; v_<name of parameter [w_idx] of [w_fn]>@<id>
    EMIT s_vpre
    mov  r9, [w_fn]
    mov  eax, [w_idx]
    shl  eax, 4
    add  r9, rax
    mov  rdx, [r9 + 32]
    mov  r8, [r9 + 40]
    call emit_bytes
    EMIT s_at
    mov  r9, [w_fn]
    mov  eax, [r9 + 16]
    jmp  emit_dec

; the call itself: arguments are on the stack (last on top)
write_call_emit:
    mov  r8, [w_fn]
    mov  eax, [r8 + 16]
    mov  [w_id], eax
    or   dword [rt_need], RT_FRAMES
    EMIT s_cmp_fa               ; the function is running already: keep its variables
    mov  eax, [w_id]
    call emit_dec
    EMIT s_fa_end0
    EMIT s_je
    SITEL s_cs, s_a_nl
    EMIT s_lea_rsi_fr
    mov  eax, [w_id]
    call emit_dec
    EMIT s_b_rbr
    EMIT s_mov_ecx_fr
    mov  eax, [w_id]
    call emit_dec
    EMIT s_be_minus
    mov  eax, [w_id]
    call emit_dec
    EMIT s_nl_b
    EMIT s_call_fsave
    EMIT s_lea_rsi_fr
    mov  eax, [w_id]
    call emit_dec
    EMIT s_d_rbr
    EMIT s_mov_ecx_fr
    mov  eax, [w_id]
    call emit_dec
    EMIT s_de_minus
    mov  eax, [w_id]
    call emit_dec
    EMIT s_nl_d
    EMIT s_call_fsave
    SITEL s_cs, s_a_lbl
    ; the arguments become the parameters (last argument first)
    mov  r8, [w_fn]
    movzx eax, byte [r8 + 20]
    mov  [w_idx], eax
.pl:
    cmp  dword [w_idx], 0
    je   .go
    dec  dword [w_idx]
    mov  r8, [w_fn]
    mov  eax, [w_idx]
    cmp  byte [r8 + 22 + rax], 2
    je   .ptext
    EMIT s_pop_rax
    EMIT s_store_c
    call emit_param_label
    EMIT s_store_b
    jmp  .pl
.ptext:
    EMIT s_pop_rdx
    EMIT s_lea_rcx
    call emit_param_label
    EMIT s_rbr_nl
    or   dword [rt_need], RT_TEXT
    EMIT s_call_lstr_set
    jmp  .pl
.go:
    EMIT s_inc_fa
    mov  eax, [w_id]
    call emit_dec
    EMIT s_fa_end
    EMIT s_call_fn
    mov  eax, [w_id]
    call emit_dec
    EMIT s_nl
    EMIT s_dec_fa
    mov  eax, [w_id]
    call emit_dec
    EMIT s_fa_end
    EMIT s_cmp_fa
    mov  eax, [w_id]
    call emit_dec
    EMIT s_fa_end0
    EMIT s_je
    SITEL s_cs, s_b_nl2x
    EMIT s_call_frest
    EMIT s_call_frest
    SITEL s_cs, s_b_lbl2
    ret

write_ca_scratch:               ; the scratch buffers of text arguments
    cmp  dword [ca_n], 0
    je   .ret
    EMIT s_sec_bss
    mov  dword [w_ci], 0
.l:
    mov  eax, [w_ci]
    cmp  eax, [ca_n]
    jae  .d
    lea  r8, [ca_tab]
    mov  eax, [r8 + rax*4]
    mov  edx, eax
    and  edx, 15
    shr  eax, 4
    mov  [w_site], eax
    mov  [w_idx], edx
    call emit_ca_label
    EMIT s_ca_decl
    inc  dword [w_ci]
    jmp  .l
.d:
    EMIT s_sec_text
.ret:
    ret

; ---- bin ------------------------------------------------------------------------------------
write_bin_load:                 ; rt_bacc := the bin in rax
    RTCALL RT_BIN, s_bin_load
    ret
write_bin_op:                   ; rt_bacc := rt_bacc <op [ex_op]> the bin in rax
    EMIT s_bin_op_a
    movzx eax, byte [ex_op]
    call emit_dec
    RTCALL RT_BIN, s_bin_op_b
    ret
write_bin_not:
    RTCALL RT_BIN, s_bin_not
    ret
write_bin_result:               ; rax := &rt_bacc
    EMIT s_bin_res
    ret
write_bin_eq:                   ; left bin in rbx, right in rax  ->  rbx / rax = 1 / 1 when equal, otherwise 0 / 1
    RTCALL RT_BIN, s_bin_eq
    ret
write_bin_from_num:
    RTCALL RT_BIN, s_bin_from
    ret
write_bin_to_num:
    RTCALL RT_BIN, s_bin_to
    ret

; a bin literal (bin_bits / bin_buf): a constant bin_<n> in .data;  rax = its address
write_lit_bin:
    inc  dword [lit_ctr]
    EMIT s_sec_data
    EMIT s_bin_pre
    mov  eax, [lit_ctr]
    call emit_dec
    EMIT s_dq
    mov  rax, [bin_bits]
    call emit_dec
    EMIT s_nl
    EMIT s_db
    mov  rdi, [bin_bits]
    add  rdi, 7
    shr  rdi, 3                 ; bytes
    xor  ebx, ebx
.byte:
    lea  rdx, [bin_buf]
    movzx eax, byte [rdx + rbx]
    call emit_dec
    inc  rbx
    cmp  rbx, rdi
    jae  .done
    EMIT s_comma
    jmp  .byte
.done:
    EMIT s_nl
    EMIT s_sec_text
    EMIT s_lea_rax
    EMIT s_bin_pre
    mov  eax, [lit_ctr]
    call emit_dec
    EMIT s_rbr_nl
    ret

; ---- while / until / for -------------------------------------------------------------
; Labels: lp_<chain>_top (the test), lp_<chain>_tgt (for: the target), lp_<chain>_up, and if_<chain>_1 (the exit).
%macro LPL 1
    EMIT s_lp_pre
    mov  eax, [cb_chain]
    call emit_dec
    EMIT %1
%endmacro

write_comment_loop:             ; in: EAX = FN_WHILE / FN_UNTIL
    cmp  eax, FN_WHILE
    jne  .u
    EMIT s_c_while
    ret
.u: EMIT s_c_until
    ret
write_comment_for:
    EMIT s_c_for
    ret

write_loop_top:                 ; lp_<chain>_top:
    LPL  s_lp_top
    EMIT s_lbl_end
    ret

write_jmp_top:                  ; jmp lp_<chain>_top
    EMIT s_jmp
    LPL  s_lp_top
    EMIT s_nl
    ret

write_for_decl:                 ; lp_<chain>_tgt: resq 1   (in .bss)
    EMIT s_sec_bss
    LPL  s_lp_tgt
    EMIT s_resq
    EMIT s_sec_text
    ret

emit_for_var:                   ; v_<loop variable>
    mov  rdx, [fo_name]
    mov  r8, [fo_len]
    jmp  emit_label_p

; the target is in rax: store it, then the test at the top of the loop
write_for_head:
    EMIT s_store_c
    LPL  s_lp_tgt
    EMIT s_store_b
    call write_loop_top
    EMIT s_mov_rax_b
    call emit_for_var
    EMIT s_rbr_nl
    EMIT s_cmp_rax_m
    LPL  s_lp_tgt
    EMIT s_rbr_nl
    EMIT s_je
    call emit_if_label_next
    EMIT s_nl
    ret

; the end of a for body: one step toward the target, then back to the test
write_for_step:
    EMIT s_mov_rax_b
    call emit_for_var
    EMIT s_rbr_nl
    EMIT s_cmp_rax_m
    LPL  s_lp_tgt
    EMIT s_rbr_nl
    EMIT s_jl
    LPL  s_lp_up
    EMIT s_nl
    EMIT s_dec_m
    call emit_for_var
    EMIT s_rbr_nl
    call write_jmp_top
    LPL  s_lp_up
    EMIT s_lbl_end
    EMIT s_inc_m
    call emit_for_var
    EMIT s_rbr_nl
    jmp  write_jmp_top

; Any other statement: not compiled yet, leave a marker so the output shows it.
; in: R14D = FN_* flag
write_func:
    EMIT s_todo
    mov  eax, r14d
    call emit_dec
    EMIT s_nl
    ret

; ---- output file ------------------------------------------------------------

out_begin:
    mov  qword [out_len], 0
    mov  dword [rt_need], 0
    EMIT s_header
    ret

out_end:                        ; footer, runtime helpers, then write the file
    EMIT s_footer
    call write_ca_scratch
    cmp  dword [rt_need], 0
    je   out_flush
    EMIT s_rt_common
    RT_IF RT_STR_LEN,     s_rt_str_len
    RT_IF RT_STR_IDX,     s_rt_str_idx
    RT_IF RT_LSTR_IDX,    s_rt_lstr_idx
    RT_IF RT_LIST_APPEND, s_rt_append
    RT_IF RT_LIST_INSERT, s_rt_insert
    RT_IF RT_LIST_REMOVE, s_rt_remove
    RT_IF RT_LIST_GET,    s_rt_get
    RT_IF RT_SORT_NUM,    s_rt_sort_num
    RT_IF RT_SORT_STR,    s_rt_sort_str
    RT_IF RT_TEXT,        s_rt_text
    RT_IF RT_TEXT_NUM,    s_rt_num
    RT_IF RT_FRAMES,      s_rt_frames
    RT_IF RT_SBSAVE,      s_rt_sbsave
    RT_IF RT_BIN,         s_rt_bin
    RT_IF RT_SBBIN,       s_rt_sbbin
    ; fall through

out_flush:
    push rbx
    sub  rsp, 64                ; entry rsp is 8 mod 16: push + 64 keeps calls aligned
    call build_out_path
    lea  rcx, [out_path]
    mov  edx, 0x40000000        ; GENERIC_WRITE
    xor  r8d, r8d
    xor  r9d, r9d
    mov  qword [rsp + 32], 2    ; CREATE_ALWAYS
    mov  qword [rsp + 40], 0x80 ; FILE_ATTRIBUTE_NORMAL
    mov  qword [rsp + 48], 0
    call CreateFileA
    cmp  rax, -1
    je   .fail
    mov  [out_handle], rax

    mov  rcx, rax
    lea  rdx, [out_buf]
    mov  r8d, [out_len]
    lea  r9, [out_written]
    mov  qword [out_written], 0
    mov  qword [rsp + 32], 0
    call WriteFile
    mov  ebx, eax               ; RBX is non-volatile: survives CloseHandle
    mov  rcx, [out_handle]
    call CloseHandle
    test ebx, ebx
    jz   .fail
    mov  rax, [out_written]
    cmp  rax, [out_len]
    jne  .fail
    add  rsp, 64
    pop  rbx
    ret
.fail:
    mov  bx, ERR_WRITE_FAILED
    jmp  error

; out_path = path_buf with its extension replaced by ".nasm".
; (the opener guarantees the last '.' of path_buf starts the extension)
build_out_path:
    lea  rdx, [path_buf]
    lea  r8, [out_path]
    xor  r9d, r9d               ; position of the last '.'
.copy:
    mov  al, [rdx]
    test al, al
    jz   .copied
    mov  [r8], al
    cmp  al, '.'
    jne  .next
    mov  r9, r8
.next:
    inc  rdx
    inc  r8
    jmp  .copy
.copied:
    test r9, r9
    cmovz r9, r8                ; (no dot: just append)
    mov  dword [r9], '.nas'
    mov  word  [r9 + 4], 'm'    ; 'm', 0
    ret

; ---- emit primitives --------------------------------------------------------

; in: RDX = bytes, R8 = count
emit_bytes:
    mov  rax, [out_len]
    lea  rcx, [rax + r8]
    cmp  rcx, OUT_SIZE
    ja   .full
    lea  r9, [out_buf]
    add  r9, rax
    xor  r10d, r10d
.copy:
    cmp  r10, r8
    jae  .done
    mov  r11b, [rdx + r10]
    mov  [r9 + r10], r11b
    inc  r10
    jmp  .copy
.done:
    mov  [out_len], rcx
    ret
.full:
    mov  bx, ERR_OUTPUT_FULL
    jmp  error

; in: RAX = unsigned value -> decimal text
emit_dec:
    lea  r9, [num_buf + 24]
    mov  r10, r9
    mov  ecx, 10
.digit:
    xor  edx, edx
    div  rcx
    add  dl, '0'
    dec  r9
    mov  [r9], dl
    test rax, rax
    jnz  .digit
    mov  rdx, r9
    mov  r8, r10
    sub  r8, r9
    jmp  emit_bytes

; The NASM label of a variable: v_<name>   (e.g. x -> v_x, __x -> v___x)
; emit_label = the declared variable (vd_*), emit_label_expr = expr_*, emit_label_ls = ls_*,
; emit_label_p = RDX = name, R8 = length
emit_label:
    mov  rdx, [vd_name]
    mov  r8, [vd_len]
    jmp  emit_label_p
emit_label_expr:
    mov  rdx, [expr_name]
    mov  r8, [expr_len]
    jmp  emit_label_p
emit_label_ls:
    mov  rdx, [ls_name]
    mov  r8, [ls_len]
emit_label_p:
    mov  [lbl_ptr], rdx
    mov  [lbl_len], r8
    EMIT s_vpre                 ; (clobbers RDX / R8)
    mov  rdx, [lbl_ptr]
    mov  r8, [lbl_len]
    call emit_bytes
    cmp  dword [cur_fn_id], 0
    je   .ret
    push rdi                    ; inside a def: a variable of the def gets  @<id>  after its name
    push rcx
    mov  rdi, [lbl_ptr]
    mov  rcx, [lbl_len]
    call find_var
    pop  rcx
    pop  rdi
    test rax, rax
    jz   .ret
    cmp  rax, [scope_lo]
    jb   .ret
    EMIT s_at
    mov  eax, [cur_fn_id]
    call emit_dec
.ret:
    ret
